{
  "manifest_version": 3,
  "name": "WideDrop",
  "description": "Drop files anywhere on Google Chat and forward them to the current compose box.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.google.com/app/chat/*",
        "https://mail.google.com/mail/u/*/#chat/space/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "WideDrop"
  }
}